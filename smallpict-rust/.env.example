APP_NAME=SmallPict Rust Service
APP_PORT=8007
APP_HOST=0.0.0.0

# Database
DATABASE_URL=postgres://postgres:postgres@localhost:5432/smallpict?sslmode=disable

# SmallPict
SMALLPICT_MODE=locale # locale | cdn
SMALLPICT_BASE_URL=https://api.smallpict.app
SMALLPICT_API_KEY=
SMALLPICT_SECRET_KEY=
SMALLPICT_FORMAT=auto
SMALLPICT_QUALITY=80

# SmallPict New Features
SMALLPICT_MAX_DIMENSION=1600 # 1600 | 1920 | 2048 | 2560 | 0 (disabled)
SMALLPICT_MAX_WIDTH=1920
SMALLPICT_MAX_HEIGHT=1080
SMALLPICT_FIT=cover # cover | contain | inside | outside
SMALLPICT_LOSSLESS=false # true | false
SMALLPICT_STRIP_METADATA=true # true | false

UPLOAD_PATH=./uploads
